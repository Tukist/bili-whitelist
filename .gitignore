# ============================================================
# bili-whitelist 仓库根 .gitignore
# 原则：敏感凭证 / 隐私数据 / 构建产物 一律不入库
# 注意：gitignore 不支持行内注释，注释一律独占一行
# ============================================================

# ---------- 敏感凭证（绝不提交） ----------
# GitHub token 配置（示例见 sync_config.example.json）
sync_config.json
# B 站登录 cookie（SESSDATA 等）
cookie.txt
cookie_new.txt
# Gist 同步备份（含真实白名单数据）
*.gistbak*
# 各类密钥文件
*.key

# ---------- 隐私数据（真实数据不入库，提供示例文件） ----------
# 真实白名单数据（示例见 whitelist.example.json）
whitelist.json
# 探针输出（含明文 URL 等中间产物）
probe_out*.json
probe_1080p_out.json

# ---------- 一次性调试探针（排查残留，不入库） ----------
# 注意：已跟踪的项目文件 probe.py / probe_1080p.py / whitelist.py 必须继续跟踪，
# 故下面一律按具体名字列举，不用会误伤它们的通配符
comment_probe*.py
comment_probe_out*.json
deadline_probe.py
deadline_probe_out.json
find_subtitle_probe.py
find_subtitle_out.json
investigator_probe.py
invest_*.py
invest_state.json
pgc_probe.py
pgc_probe_out.json
subtitle_probe*.py
subtitle_probe*_out.json
tmp_drive.py

# ---------- 录屏抽帧中间产物（可由 docs/screenshots 下的 mp4 重新生成） ----------
docs/screenshots/**/_frames_*/

# ---------- 验证期中间产物（未打码的 prefs / 白名单快照，不入库） ----------
# _work/ 里有 adb 拉下来的 FlutterSharedPreferences.xml（真实 mid / bvid / 观看历史）
# 与注入用 XML、wl.json、server*.log；_backup/ 同样是整份真实 prefs + 白名单缓存快照。
# 都是取证中间件而非交付物，且未做任何打码，一律排除。
docs/screenshots/**/_work/
docs/screenshots/**/_backup/

# ---------- 调试期截图（Gist ID 未打码，不入库；README 用的是 v2.18.0/） ----------
docs/screenshots/v2.18.0-r2/

# ---------- Python ----------
__pycache__/
*.pyc

# ---------- 临时文件 ----------
*.bak
*.tmp

# ---------- 系统杂项 ----------
Thumbs.db
Desktop.ini
