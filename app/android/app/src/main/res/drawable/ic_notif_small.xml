<?xml version="1.0" encoding="utf-8"?>
<!--
  通知状态栏小图标（v2.32.0）：一个「播放三角 + 圆环」。

  为什么自建：状态栏小图标必须是**纯白单色**（系统只取 alpha 通道），
  应用启动图标（mipmap/ic_launcher，彩色 PNG）放上去会变成一块色斑；
  media3 自带的 exo_notification_small_icon 是库内私有资源，
  应用 R 类里没有（nonTransitiveRClass，实测 Unresolved reference）。
  24dp 视口、内容缩到中间 18dp 以内，避免被系统的小图标遮罩裁边。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3A9,9 0,1 0,21 12,9 9 0,0 0,12 3zM12,5a7,7 0,1 1,-7 7,7 7,0 0,1 7,-7z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,8.5L16,12l-6,3.5z" />
</vector>
