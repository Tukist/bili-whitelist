<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 播放流 / API 请求 / 白名单同步都需要网络（debug/profile 清单自带，主清单必须声明，否则 release 断网） -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 应用内版本更新（M1.3）：下载 APK 后通过系统安装器触发安装流程。min_sdk=26 → FileProvider 强制走。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <application
        android:label="ビリビリ"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- 禁用系统自动备份：flutter_secure_storage 9.x 的 AES 密钥存于 Android
             Keystore（硬件绑定），备份/恢复到新设备后 Keystore key 失效，解密报
             InvalidKeyException: Failed to unwrap key → 配置保存失败 / 登录态读不到
             （见 pub.dev 该包官方文档警告）。本地数据可由 Gist/API 重新同步，
             完全禁用备份避免 key 失效导致的安全存储不可用。 -->
        <!-- API 35 模拟器（gfxstream/swiftshader 软渲染）下 Impeller 的 OpenGLES
             后端渲染 SurfaceTexture 纹理黑屏（flutter 已知问题，fvp#197 等）。
             禁用 Impeller 回退 Skia 后 Texture 视频画面正常；真机（Vulkan/GPU）
             不受影响。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- 应用内版本更新（M1.3）：FileProvider 暴露 ApplicationSupport/updates 目录
             给系统安装器，避免直接传 file:// URI（API 24+ 抛 FileUriExposedException）。
             authority 用 ${applicationId}.fileprovider，与 Kotlin ApkInstaller 硬编码保持一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 应用内版本更新（M1.3）：需要能查系统安装器（package-archive MIME）。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
    </queries>
</manifest>
